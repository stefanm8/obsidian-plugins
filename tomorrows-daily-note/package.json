{
	"name": "tomorrows-daily-note",
	"version": "1.0.0",
	"description": "Obsidian plugin: a sidebar item that creates tomorrow's daily note.",
	"main": "main.js",
	"private": true,
	"repository": {
		"type": "git",
		"url": "https://github.com/stefanm8/obsidian-plugins.git",
		"directory": "tomorrows-daily-note"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "node test/run.mjs",
		"install-plugin": "node scripts/install.mjs"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"daily-notes"
	],
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.11.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "0.20.2",
		"moment": "^2.30.1",
		"obsidian": "1.13.1",
		"tslib": "2.6.2",
		"typescript": "5.4.5"
	}
}
